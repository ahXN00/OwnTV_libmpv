--- a/libavcodec/mediacodecdec_common.c
+++ b/libavcodec/mediacodecdec_common.c
@@ -773,6 +773,9 @@ static int mediacodec_dec_get_video_codec(AVCodecContext *avctx, MediaCodecDecCo
     }
 
     profile = ff_AMediaCodecProfile_getProfileFromAVCodecContext(avctx);
+    /* OwnTV: a Dolby Vision decoder lists Dolby Vision profiles, never the HEVC one. */
+    if (s->dv_profile > 0)
